PORT=3000
NODE_ENV=development

# MongoDB — levantar con: docker compose up -d (puerto 27020)
MONGODB_URI=mongodb://pizzeria:pizzeria123@localhost:27020/pizzeria_security_dev?authSource=admin

# JWT — generar con: openssl rand -base64 64 (deben ser distintos entre sí)
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_access
JWT_REFRESH_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
